# Copier en ".env.local" (ignoré par git) pour brancher le baromètre sur n8n.
# Variable publique (visible dans le navigateur) : n'y mettre qu'une URL, jamais une clé.
# Laisser vide pour rester sur les données d'exemple.
VITE_N8N_BAROMETRE_URL=https://n8n-mmc3.onrender.com/webhook/barometre-mangue
# Facultatif : veille conformité (workflow 04). Laissée vide, elle est déduite de l'URL ci-dessus (…/webhook/conformite-mangue).
VITE_N8N_CONFORMITE_URL=
# Espace membre (/espace) : Supabase → Project Settings → API. Clé PUBLIQUE « anon » (ou « publishable ») seulement,
# jamais la clé « service_role ». Laissées vides, l'espace membre s'affiche en démonstration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Contact affiché pour passer Premium (paiement Mobile Money à la main pour l'instant).
# WhatsApp au format international sans + ni espaces (ex. 2250700000000).
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_EMAIL=
