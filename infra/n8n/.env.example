# Plan B uniquement (VM Docker, voir GUIDE-HEBERGEMENT.md). Avec Render, utiliser render.env.example.
# Copier ce fichier en ".env" SUR LE SERVEUR uniquement, puis remplacer chaque valeur.
# Ne jamais partager ni versionner le fichier .env.

# Sous-domaine pointant vers l'IP publique du serveur (ex. mon-ie.duckdns.org)
DOMAIN=CHANGER-moi.duckdns.org

# Fuseau horaire des déclencheurs planifiés (ex. Africa/Abidjan, Africa/Dakar, Europe/Paris)
TIMEZONE=Africa/Abidjan

# Base Postgres interne de n8n
POSTGRES_USER=n8n
POSTGRES_DB=n8n
# Générer avec : openssl rand -hex 24
POSTGRES_PASSWORD=CHANGER-MOI

# Clé de chiffrement des credentials n8n. Générer avec : openssl rand -hex 32
# La sauvegarder hors du serveur : sans elle, les credentials sont irrécupérables.
N8N_ENCRYPTION_KEY=CHANGER-MOI
