# Variables à saisir dans Render → service n8n → Environment.
# Modèle uniquement : remplacer chaque CHANGER-MOI dans Render, jamais dans ce fichier.

# --- Adresse publique ---
N8N_HOST=n8n-mmc3.onrender.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n-mmc3.onrender.com/
N8N_EDITOR_BASE_URL=https://n8n-mmc3.onrender.com/
N8N_PROXY_HOPS=1

# --- Fuseau horaire des déclencheurs planifiés ---
GENERIC_TIMEZONE=Africa/Abidjan
TZ=Africa/Abidjan

# --- Clé de chiffrement des credentials (obligatoire sur Render) ---
# Générer une fois : openssl rand -hex 32  (ou un générateur de mots de passe, 64 caractères)
# La garder hors de Render : sans elle, les credentials sont irrécupérables.
N8N_ENCRYPTION_KEY=CHANGER-MOI

# --- Base Supabase (Connect → Session pooler, port 5432) ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=aws-0-CHANGER-MOI.pooler.supabase.com
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres.CHANGER-MOI
DB_POSTGRESDB_PASSWORD=CHANGER-MOI
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false
DB_POSTGRESDB_POOL_SIZE=2

# --- Économie de place et de mémoire ---
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=2000
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_RUNNERS_ENABLED=true

# --- Facultatif : masquer l'Assistant n8n (il exige un bac à sable impossible sur Render gratuit) ---
# N8N_DISABLED_MODULES=instance-ai
